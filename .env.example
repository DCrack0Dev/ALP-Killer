# Copy to .env on the backend host. Never commit the resulting file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://alpaca:CHANGE_ME@postgres:5432/alpaca_killer
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Generate both with the commands in docs/deployment.md.
JWT_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
# This is the app unlock passphrase used to issue a short-lived backend session.
BOOTSTRAP_PASSPHRASE=REPLACE_WITH_A_LONG_UNIQUE_PASSPHRASE
SESSION_TTL_MINUTES=30
ALLOW_LIVE_TRADING=false
WORKER_POLL_SECONDS=300
ALLOWED_ORIGINS=https://your-private-app-endpoint.example
