<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production permits TLS only. Debug resource overlay permits loopback HTTP solely for local development. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
